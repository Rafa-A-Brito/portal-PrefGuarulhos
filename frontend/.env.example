# Copie para ".env.local" se quiser sobrescrever algum desses padrões.
# Nenhuma delas é obrigatória: sem a chave do Google Maps, o mapa funciona
# normalmente num modo mockup (sem custo de API); sem VITE_API_BASE_URL, o
# front assume que o backend está em http://localhost:4000.

VITE_GOOGLE_MAPS_API_KEY=
VITE_API_BASE_URL=http://localhost:4000
