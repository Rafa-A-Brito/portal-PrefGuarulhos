# Desenvolvimento local. No Docker, a base /api é definida durante o build.
VITE_API_BASE_URL=http://localhost:3333/api
# Opcional; sem chave, o mapa usa o modo mock.
# VITE_GOOGLE_MAPS_API_KEY=sua_chave_restrita_por_dominio
VITE_USE_MOCK_MAP=false
VITE_GEOCODING_ATIVO=false
VITE_MOSTRAR_DETALHES_ERRO=false
# Somente habilitar em homologação isolada autorizada. Não é autorização de produção.
VITE_METRICAS_ATIVAS=false
# Feedback público: habilitar apenas no processo de desenvolvimento/homologação autorizado.
VITE_FEEDBACK_ATIVO=false
# API exclusiva opcional: exportar no terminal que inicia o Vite (cmd.exe: set).
# FEEDBACK_PROXY_TARGET=http://127.0.0.1:3358
# Não é VITE_* nem define a base do cliente administrativo (VITE_API_BASE_URL).

# Map ID JavaScript do projeto Google Cloud (DEMO_MAP_ID somente para testes).
VITE_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
