# Copie para ".env.local" se quiser sobrescrever algum desses padrões.
# Nenhuma delas é obrigatória.

# Endereço do backend. Sem isso, o front usa http://localhost:4000.
VITE_API_BASE_URL=http://localhost:4000

# A chave do Google Maps NÃO fica aqui: ela mora no backend/.env
# (GOOGLE_MAPS_KEY) e o front busca em GET /config/mapa. Use a linha abaixo
# só se quiser forçar o mapa em modo mockup, pra não gastar cota da API
# enquanto mexe no layout.
# VITE_USE_MOCK_MAP=true
