# Mapa público (/mapa). Comentários ficam em linhas próprias: o valor de
# uma variável não pode ter "# ..." na mesma linha.

# true = força o mapa em modo mockup (sem Google Maps, sem custo).
VITE_USE_MOCK_MAP=

# Chave do Google Maps (Maps JavaScript API), restrita por domínio. Vazia =
# mapa em modo mockup. É a mesma chave usada pelo geocoding do admin.
VITE_GOOGLE_MAPS_API_KEY=

# VITE_API_BASE_URL=http://localhost:3333

# Backend (só quando a API for religada; veja a seção 7)
VITE_API_BASE_URL=http://localhost:3333/api

# Geocodificação do endereço (seção 5), feita ao salvar um patrimônio no
# admin. true = usa o Google (exige VITE_GOOGLE_MAPS_API_KEY).
# false/vazio = não gera coordenadas: o patrimônio é salvo sem posição no mapa.
VITE_GEOCODING_ATIVO=

# Resumo com IA a partir de arquivo (seção 6). false = modo demonstração.
VITE_IA_RESUMO_ATIVA=

# Mostra o campo "Detalhe" técnico no modal de erro. Em produção deixe false.
VITE_MOSTRAR_DETALHES_ERRO= 
