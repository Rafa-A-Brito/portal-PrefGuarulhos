# Docker local. Substitua os placeholders antes de iniciar.
POSTGRES_USER=portal
POSTGRES_PASSWORD=SUBSTITUA_POR_SEGREDO_ALEATORIO
POSTGRES_DB=patrimonio_guarulhos
POSTGRES_PORT=5433
BACKEND_PORT=3333
FRONTEND_PORT=8090
CORS_ORIGIN=http://localhost:8090
JWT_SECRET=SUBSTITUA_POR_SEGREDO_ALEATORIO_COM_32_OU_MAIS_CARACTERES
JWT_TTL_SECONDS=900
VITE_GEOCODING_ATIVO=false
# VITE_GOOGLE_MAPS_API_KEY=sua_chave_restrita_por_dominio
# Use senha alfanumérica/hexadecimal ou percent-encoding na URL PostgreSQL.
# Uploads Docker ficam em uploads_data (/app/uploads).
TEST_POSTGRES_PASSWORD=SUBSTITUA_POR_OUTRO_SEGREDO_ALEATORIO
TEST_POSTGRES_PORT=5434
TEST_JWT_SECRET=SUBSTITUA_POR_OUTRO_SEGREDO_COM_32_OU_MAIS_CARACTERES
TEST_BACKEND_PORT=3334
TEST_FRONTEND_PORT=8091

# Map ID JavaScript do Google Cloud; substitua o ID de demonstração em produção.
VITE_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
