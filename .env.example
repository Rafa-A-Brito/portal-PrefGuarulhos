# Copie para ".env" na raiz do projeto para customizar o docker-compose.
# Sem esse arquivo, os valores padrão abaixo já são usados automaticamente.

MYSQL_ROOT_PASSWORD=guarulhos
MYSQL_DATABASE=guarulhos_patrimonio

# Portas expostas na sua máquina (host) — mude se já tiver algo rodando nelas.
# (3306/8080 são portas comuns; usamos valores menos prováveis de já estarem
# ocupados por outro projeto seu, mas ajuste à vontade.)
MYSQL_PORT=3309
BACKEND_PORT=4000
FRONTEND_PORT=8090
