[Unit]
Description=Retenção de métricas do Portal (exemplo, não habilitado)
After=docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/
Environment=DOCKER_HOST=unix:///var/run/docker.sock
Environment=DOCKER_CONFIG=/etc/portal/docker
LoadCredential=metricas.env:/etc/portal/metricas-operacao.env
ExecStart=/usr/bin/docker exec --user node --workdir /app --env-file %d/metricas.env NOME_BACKEND timeout --signal=TERM --kill-after=10s 840s node scripts/reter_metricas.js
TimeoutStartSec=15min
Restart=no
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=portal-metricas-retencao
