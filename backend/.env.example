PORT=3333
DATABASE_URL=postgresql://portal_api:SUBSTITUA_A_SENHA@127.0.0.1:5433/patrimonio_guarulhos
# Somente no processo de migração, nunca no ambiente da API:
# MIGRATION_DATABASE_URL=postgresql://portal_migrator:SENHA_EXCLUSIVA@127.0.0.1:5433/patrimonio_guarulhos
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=SUBSTITUA_POR_SEGREDO_ALEATORIO_COM_32_OU_MAIS_CARACTERES
JWT_TTL_SECONDS=900
# Vazio = acesso direto, sem confiar em cabeçalhos do cliente.
# Atrás de proxy: informe SOMENTE os IPs/CIDRs dos proxies reais.
TRUST_PROXY_IPS=
LOGIN_RATE_WINDOW_MS=900000
LOGIN_RATE_IP_MAX=100
LOGIN_RATE_ACCOUNT_IP_MAX=10
# Gere JWT_SECRET aleatório exclusivo por ambiente (ver docs/SEGURANCA.md).
# Padrão: backend/uploads; caminho relativo é resolvido a partir do diretório de execução.
# UPLOAD_DIR=C:/dados/portal/uploads
# Exclusivamente para scripts test:db:* / test:integration:
# TEST_DATABASE_URL=postgresql://portal_test:SENHA_DE_TESTE@127.0.0.1:5434/portal_test
# TEST_DATABASE_EXCLUSIVE=1
# Pasta raiz das mídias enviadas. Em produção aponte para o volume que entra no backup.
UPLOAD_ROOT=uploads
UPLOAD_MAX_IMAGE_BYTES=5242880
UPLOAD_MAX_DOCUMENT_BYTES=10485760
# URL pública do backend (inclua prefixo de proxy, se houver). Obrigatória para a seed.
PATRIMONIOS_PUBLIC_BASE_URL=http://localhost:3333
