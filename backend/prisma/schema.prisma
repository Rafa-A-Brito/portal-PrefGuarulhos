generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  EDITOR
  ADMIN

  @@map("role")
}

enum SituacaoPatrimonio {
  PRESERVADO
  EM_RESTAURACAO
  NECESSITA_RESTAURACAO
  EM_RUINAS
  DEMOLIDO
  NAO_INFORMADO

  @@map("situacao_patrimonio")
}

enum StatusPublicacao {
  RASCUNHO
  PUBLICADO
  ARQUIVADO

  @@map("status_publicacao")
}

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String   @db.VarChar(100)
  email        String   @unique(map: "users_email_key") @db.VarChar(254)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  role         Role     @default(EDITOR)
  isActive     Boolean  @default(true) @map("is_active")
  tokenVersion Int      @default(0) @map("token_version")
  authSessions AuthSession[]
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  patrimoniosCriados     Patrimonio[] @relation("PatrimonioCriadoPor")
  patrimoniosAtualizados Patrimonio[] @relation("PatrimonioAtualizadoPor")
  exposicoesCriadas      Exposicao[]  @relation("ExposicaoCriadoPor")
  exposicoesAtualizadas  Exposicao[]  @relation("ExposicaoAtualizadoPor")
  novidadesCriadas       Novidade[]   @relation("NovidadeCriadoPor")
  novidadesAtualizadas   Novidade[]   @relation("NovidadeAtualizadoPor")
  auditLogs              AuditLog[]

  @@map("users")
}

model AuthSession {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String @map("user_id") @db.Uuid
  tokenVersion Int @map("token_version")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt    DateTime @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  user         User @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]
  @@index([userId])
  @@map("auth_sessions")
}

model RefreshToken {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId String @map("session_id") @db.Uuid
  tokenHash String @unique @map("token_hash") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  session   AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  @@index([sessionId])
  @@map("refresh_tokens")
}

model Categoria {
  id           String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome         String                @unique(map: "categoria_nome_key") @db.VarChar(100)
  slug         String                @unique(map: "categoria_slug_key") @db.VarChar(120)
  descricao    String?               @db.Text
  createdAt    DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  patrimonios  Patrimonio[]
  adicionaisEm PatrimonioCategoria[]

  @@map("categoria")
}

model RegiaoPatrimonio {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome        String       @db.VarChar(100)
  slug        String       @unique(map: "regioes_patrimonio_slug_key") @db.VarChar(120)
  descricao   String?      @db.VarChar(2000)
  ativo       Boolean      @default(true)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  patrimonios Patrimonio[]

  @@map("regioes_patrimonio")
}

model Patrimonio {
  id                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome                String             @map("name") @db.VarChar(200)
  slug                String             @unique(map: "patrimonio_slug_key") @db.VarChar(220)
  regiaoId            String?            @map("regiao_id") @db.Uuid
  numeroExibicao      Int?               @unique(map: "patrimonio_numero_exibicao_key") @map("numero_exibicao")
  ordemExibicao       Int?               @map("ordem_exibicao")
  regiao              RegiaoPatrimonio?  @relation(fields: [regiaoId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  descricao           String             @db.Text
  descricaoResumida   String             @map("descricao_resumida") @db.VarChar(500)
  historia            String?            @db.Text
  importanciaCultural String?            @map("importancia_cultural") @db.Text
  situacao            SituacaoPatrimonio @default(NAO_INFORMADO)
  status              StatusPublicacao   @default(RASCUNHO)
  categoriaId         String             @map("categoria_id") @db.Uuid
  createdBy           String             @map("created_by") @db.Uuid
  updatedBy           String?            @map("updated_by") @db.Uuid
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  publicadoEm         DateTime?          @map("published_at") @db.Timestamptz(3)
  arquivadoEm         DateTime?          @map("arquivado_em") @db.Timestamptz(3)

  categoria            Categoria             @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  criadoPor            User                  @relation("PatrimonioCriadoPor", fields: [createdBy], references: [id], onDelete: Restrict)
  atualizadoPor        User?                 @relation("PatrimonioAtualizadoPor", fields: [updatedBy], references: [id], onDelete: Restrict)
  localizacao          Localizacao?
  imagens              PatrimonioImagem[]
  documentos           PatrimonioDocumento[]
  rotas                RotaPatrimonio[]
  fatos                PatrimonioFato[]
  ligacoes             PatrimonioLigacao[]   @relation("LigacaoOrigem")
  ligacoesRecebidas    PatrimonioLigacao[]   @relation("LigacaoDestino")
  categoriasAdicionais PatrimonioCategoria[]
  detalhes             PatrimonioDetalhe[]
  visualizacoesUnicas   VisualizacaoUnicaDia[]
  visualizacoesDiarias  VisualizacaoTotalDia[]

  @@index([categoriaId, status])
  @@index([regiaoId], map: "patrimonio_regiao_id_idx")
  @@index([ordemExibicao, nome, id], map: "patrimonio_ordem_exibicao_nome_id_idx")
  @@index([createdBy])
  @@index([updatedBy])
  @@index([status])
  @@map("patrimonio")
}

model VisualizacaoUnicaDia {
  dia            DateTime   @db.Date
  patrimonioId   String     @map("patrimonio_id") @db.Uuid
  chaveVisitante String     @map("chave_visitante") @db.Char(64)
  patrimonio     Patrimonio @relation(fields: [patrimonioId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([dia, patrimonioId, chaveVisitante])
  @@index([patrimonioId, dia])
  @@map("visualizacoes_unicas_dia")
}

model VisualizacaoTotalDia {
  dia          DateTime   @db.Date
  patrimonioId String     @map("patrimonio_id") @db.Uuid
  quantidade   BigInt     @default(0)
  patrimonio   Patrimonio @relation(fields: [patrimonioId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([dia, patrimonioId])
  @@index([patrimonioId, dia])
  @@map("visualizacoes_totais_dia")
}

enum EstadoSondaMetricas {
  DISPONIVEL
  DESATIVADA
  FALHA

  @@map("estado_sonda_metricas")
}

model OperacaoMetricas {
  id               Int       @id @default(1)
  inicioObservacao DateTime? @map("inicio_observacao") @db.Timestamptz(3)
  recibosAntesDe   DateTime? @map("recibos_antes_de") @db.Date
  agregadosAntesDe DateTime? @map("agregados_antes_de") @db.Date
  ultimaRetencaoEm DateTime? @map("ultima_retencao_em") @db.Timestamptz(3)

  @@map("operacao_metricas")
}

model DiaMetricasConferido {
  dia         DateTime @id @db.Date
  conferidoEm DateTime @map("conferido_em") @db.Timestamptz(3)

  @@map("dias_metricas_conferidos")
}

model SondaMetricas {
  janelaInicio DateTime           @id @map("janela_inicio") @db.Timestamptz(0)
  observadoEm  DateTime           @map("observado_em") @db.Timestamptz(3)
  estado       EstadoSondaMetricas
  versaoRegra  Int                @map("versao_regra")

  @@map("sondas_metricas")
}

model PatrimonioDetalhe {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patrimonioId String  @map("patrimonio_id") @db.Uuid
  icone        String?
  titulo       String
  texto        String
  ordem        Int     @default(0)

  patrimonio Patrimonio @relation(fields: [patrimonioId], references: [id], onDelete: Cascade)

  @@index([patrimonioId, ordem])
  @@map("patrimonio_detalhes")
}

model PatrimonioFato {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patrimonioId String     @map("patrimonio_id") @db.Uuid
  rotulo       String     @db.VarChar(200)
  valor        String     @db.Text
  ordem        Int
  patrimonio   Patrimonio @relation(fields: [patrimonioId], references: [id], onDelete: Cascade)

  @@unique([patrimonioId, ordem], map: "patrimonio_fatos_patrimonio_id_ordem_key")
  @@map("patrimonio_fatos")
}

model PatrimonioLigacao {
  id                  String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patrimonioOrigemId  String     @map("patrimonio_origem_id") @db.Uuid
  patrimonioDestinoId String     @map("patrimonio_destino_id") @db.Uuid
  texto               String     @db.VarChar(2000)
  ordem               Int
  origem              Patrimonio @relation("LigacaoOrigem", fields: [patrimonioOrigemId], references: [id], onDelete: Cascade, map: "patrimonio_ligacoes_origem_fkey")
  destino             Patrimonio @relation("LigacaoDestino", fields: [patrimonioDestinoId], references: [id], onDelete: Cascade, map: "patrimonio_ligacoes_destino_fkey")

  @@unique([patrimonioOrigemId, patrimonioDestinoId], map: "patrimonio_ligacoes_origem_destino_key")
  @@unique([patrimonioOrigemId, ordem], map: "patrimonio_ligacoes_origem_ordem_key")
  @@index([patrimonioDestinoId], map: "patrimonio_ligacoes_destino_idx")
  @@map("patrimonio_ligacoes")
}

model SiteHero {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pagina    String   @unique
  eyebrow   String?
  titulo    String
  subtitulo String?
  imagemUrl String?
  ctaLabel  String?
  ctaUrl    String?
  ativo     Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@map("site_hero")
}

model Localizacao {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patrimonioId String     @unique(map: "local_patrimonio_id_key") @map("patrimonio_id") @db.Uuid
  endereco     String     @db.VarChar(250)
  numero       String?    @db.VarChar(30)
  complemento  String?    @db.VarChar(150)
  bairro       String     @db.VarChar(100)
  cidade       String     @default("Guarulhos") @db.VarChar(100)
  uf           String     @default("SP") @db.Char(2)
  cep          String?    @db.VarChar(9)
  latitude     Decimal?   @db.Decimal(10, 7)
  longitude    Decimal?   @db.Decimal(10, 7)
  patrimonio   Patrimonio @relation(fields: [patrimonioId], references: [id], onDelete: Cascade)

  @@map("local")
}

model PatrimonioImagem {
  id               String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patrimonioId     String     @map("patrimonio_id") @db.Uuid
  url              String     @db.Text
  titulo           String?    @db.VarChar(200)
  textoAlternativo String     @map("alt") @db.VarChar(300)
  credito          String?    @db.VarChar(200)
  fonte            String?    @db.VarChar(500)
  ordem            Int        @default(0)
  principal        Boolean    @default(false) @map("is_capa")
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  patrimonio       Patrimonio @relation(fields: [patrimonioId], references: [id], onDelete: Cascade)

  @@index([patrimonioId, ordem])
  @@map("patrimonio_imagens")
}

model PatrimonioDocumento {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patrimonioId  String     @map("patrimonio_id") @db.Uuid
  titulo        String     @db.VarChar(200)
  descricao     String?    @db.Text
  url           String     @db.Text
  tipo          String     @db.VarChar(100)
  fonte         String?    @db.VarChar(500)
  dataDocumento DateTime?  @map("data_documento") @db.Date
  mimeType      String?    @map("mime_type") @db.VarChar(100)
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  patrimonio    Patrimonio @relation(fields: [patrimonioId], references: [id], onDelete: Cascade)

  @@index([patrimonioId])
  @@map("patrimonio_documentos")
}

model Rota {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome        String           @map("name") @db.VarChar(200)
  slug        String           @unique(map: "rota_slug_key") @db.VarChar(220)
  descricao   String?          @db.Text
  status      StatusPublicacao @default(RASCUNHO)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  patrimonios RotaPatrimonio[]

  @@index([status])
  @@map("rota")
}

model RotaPatrimonio {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rotaId       String     @map("rota_id") @db.Uuid
  patrimonioId String     @map("patrimonio_id") @db.Uuid
  ordem        Int
  rota         Rota       @relation(fields: [rotaId], references: [id], onDelete: Cascade)
  patrimonio   Patrimonio @relation(fields: [patrimonioId], references: [id], onDelete: Cascade)

  @@unique([rotaId, patrimonioId], map: "rota_patrimonio_rota_id_patrimonio_id_key")
  @@unique([rotaId, ordem], map: "rota_patrimonio_rota_id_ordem_key")
  @@index([patrimonioId])
  @@map("rota_patrimonio")
}

model AuditLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  action    String   @db.VarChar(100)
  entity    String   @db.VarChar(100)
  entityId  String   @map("entity_id") @db.Uuid
  oldValues Json?    @map("old_values") @db.JsonB
  newValues Json?    @map("new_values") @db.JsonB
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_log")
}

// Categorias ADICIONAIS de um patrimônio. A categoria principal continua em
// patrimonio.categoria_id (obrigatória); aqui ficam as demais, para que o bem
// também apareça nos filtros dessas categorias.
model PatrimonioCategoria {
  patrimonioId String     @map("patrimonio_id") @db.Uuid
  categoriaId  String     @map("categoria_id") @db.Uuid
  patrimonio   Patrimonio @relation(fields: [patrimonioId], references: [id], onDelete: Cascade)
  categoria    Categoria  @relation(fields: [categoriaId], references: [id], onDelete: Restrict)

  @@id([patrimonioId, categoriaId])
  @@index([categoriaId])
  @@map("patrimonio_categoria")
}

enum TipoNovidade {
  NOTICIA
  EVENTO

  @@map("tipo_novidade")
}

model Exposicao {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug          String           @unique(map: "exposicao_slug_key") @db.VarChar(220)
  titulo        String           @db.VarChar(200)
  artista       String           @db.VarChar(200)
  local         String           @db.VarChar(250)
  periodo       String           @db.VarChar(200)
  bio           String           @db.Text
  imagemUrl     String           @map("imagem_url") @db.Text
  ctaSaibaMais  String?          @map("cta_saiba_mais") @db.Text
  status        StatusPublicacao @default(RASCUNHO)
  createdBy     String           @map("created_by") @db.Uuid
  updatedBy     String?          @map("updated_by") @db.Uuid
  publicadoEm   DateTime?        @map("published_at") @db.Timestamptz(3)
  arquivadoEm   DateTime?        @map("arquivado_em") @db.Timestamptz(3)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  criadoPor     User             @relation("ExposicaoCriadoPor", fields: [createdBy], references: [id], onDelete: Restrict)
  atualizadoPor User?            @relation("ExposicaoAtualizadoPor", fields: [updatedBy], references: [id], onDelete: Restrict)

  @@index([status, publicadoEm])
  @@index([createdBy])
  @@index([updatedBy])
  @@map("exposicao")
}

model Novidade {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug          String           @unique(map: "novidade_slug_key") @db.VarChar(220)
  tipo          TipoNovidade
  tag           String           @db.VarChar(100)
  data          DateTime         @db.Date
  titulo        String           @db.VarChar(200)
  resumo        String?          @db.VarChar(2000)
  texto         String           @db.Text
  quando        String?          @db.VarChar(250)
  local         String?          @db.VarChar(250)
  imagemUrl     String?          @map("imagem_url") @db.Text
  blocoDia      String?          @map("bloco_dia") @db.VarChar(30)
  blocoMes      String?          @map("bloco_mes") @db.VarChar(30)
  blocoLegenda  String?          @map("bloco_legenda") @db.VarChar(150)
  ctaRotulo     String?          @map("cta_rotulo") @db.VarChar(150)
  ctaUrl        String?          @map("cta_url") @db.Text
  fontes        Json             @default("[]") @db.JsonB
  status        StatusPublicacao @default(RASCUNHO)
  createdBy     String           @map("created_by") @db.Uuid
  updatedBy     String?          @map("updated_by") @db.Uuid
  publicadoEm   DateTime?        @map("published_at") @db.Timestamptz(3)
  arquivadoEm   DateTime?        @map("arquivado_em") @db.Timestamptz(3)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  criadoPor     User             @relation("NovidadeCriadoPor", fields: [createdBy], references: [id], onDelete: Restrict)
  atualizadoPor User?            @relation("NovidadeAtualizadoPor", fields: [updatedBy], references: [id], onDelete: Restrict)

  @@index([status, publicadoEm])
  @@index([status, tipo, data])
  @@index([status, data])
  @@index([createdBy])
  @@index([updatedBy])
  @@map("novidade")
}
